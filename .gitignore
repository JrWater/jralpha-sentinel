# Credentials — never commit
.env
.env.dev
.env.*.local

# Live trading state and logs: per-run artifacts of the competition account,
# not source. The judged, credential-free view is docs/snapshot.json, which
# IS tracked.
state/
logs/

# Rendered video outputs and snapshot scratch — large binaries rebuilt from
# the composition by `npm run render` / `hyperframes snapshot`.
sentinel-video/out/
sentinel-video/.snapshots*/
sentinel-video/.thumbnails/
sentinel-video/.s04chk/
sentinel-video/.snapcap/

# Intermediate slide/video renders. The sources (slides.html, cover.html,
# code.html, script.json) and the webp deliverables are tracked.
media/audio/
media/audio_el/
media/build/clips/
media/build/qa/
media/build/*.png
media/build/*.pdf
media/build/*.mp4

__pycache__/
*.pyc
.venv/
