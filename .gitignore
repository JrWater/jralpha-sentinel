# Credentials — never commit
.env
.env.dev
.env.*.local

# Live trading state and logs: per-run artifacts of the competition account,
# not source. The judged, credential-free view is docs/snapshot.json, which
# IS tracked.
state/
logs/

# Rendered video outputs and snapshot scratch — large binaries rebuilt from
# the composition by `npm run render` / `hyperframes snapshot`.
sentinel-video/out/
sentinel-video/.snapshots*/
sentinel-video/snapshots/
sentinel-video/.thumbnails/
sentinel-video/.s04chk/
sentinel-video/.snapcap/

# The preview composition is now the provenance source for the published
# deliverables. Keep its source tracked while excluding reproducible renders
# and inspection caches, exactly as for the canonical composition above.
sentinel-video-preview/out/
sentinel-video-preview/.snapshots*/
sentinel-video-preview/snapshots/
sentinel-video-preview/.thumbnails/
sentinel-video-preview/.checkshots/
sentinel-video-preview/.owlcheck/

# Intermediate slide/video renders. The sources (slides.html, cover.html,
# code.html, script.json) and the webp deliverables are tracked.
media/audio/
media/audio_el/
media/build/clips/
media/build/qa/
media/build/*.png
media/build/*.pdf
media/build/*.mp4
media/build-preview/*.png
media/build-preview/*.pdf

__pycache__/
*.pyc
.venv/
.DS_Store
